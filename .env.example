# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# ─── MinIO (original file storage) ───────────────────────────────────────────
# docker-compose overrides MINIO_ENDPOINT to minio:9000 inside the network.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MAX_UPLOAD_MB=50

# ─── OpenRouter (embeddings + chat) ──────────────────────────────────────────
# Leave the key empty to run with stub embeddings / stub answers.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8010
